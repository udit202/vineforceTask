        "properties": {
          "orderId": {
            "type": "integer",
            "format": "int32"
          },
          "razorpayOrderId": {
            "minLength": 1,
            "type": "string"
          },
          "razorpayPaymentId": {
            "minLength": 1,
            "type": "string"
          },
          "razorpaySignature": {
            "minLength": 1,
